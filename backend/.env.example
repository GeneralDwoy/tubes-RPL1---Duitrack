# ============================================================
# DuiTrack Backend — Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai sesuai.
# JANGAN commit file .env ke Git!
# ============================================================

# --- Server ---
PORT=3000

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=duitrack

# --- JWT ---
# Gunakan string acak panjang (min 32 karakter) untuk production
JWT_SECRET=your_long_random_secret_min_32_chars

# --- CORS ---
# URL frontend yang diizinkan mengakses API ini.
# Pisahkan dengan koma jika lebih dari satu.
FRONTEND_URL=http://localhost:5173